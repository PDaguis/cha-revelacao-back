# Copie para .env.
#
# Com Docker, o docker compose lê este arquivo sozinho.
# Sem Docker, rode com: node --env-file=.env server.js

# Domínio do site, para o Caddy emitir o certificado.
# Use :80 para testar sem domínio e sem HTTPS.
DOMINIO=cha.seudominio.com.br

# Senha do DELETE /votos, para limpar os palpites de teste antes da festa.
# Vazio deixa a rota desligada.
ADMIN_TOKEN=

# Usados só quando se roda o servidor fora do Docker:
# PORT=3000
# DATA_FILE=./dados/votos.json
# CORS_ORIGIN=*
